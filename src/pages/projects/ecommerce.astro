---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import { useTranslations } from '../../lib/i18n';
import { getLangFromUrl } from '../../lib/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title="ECommerce - Tech Partners" lang={lang}>
  <Navigation />
  <div class="min-h-screen flex flex-col">

    <main class="flex-1 container mx-auto px-4 py-20">
      <div class="max-w-4xl mx-auto">
        <div class="mb-12 animate-fade-in">
          <p class="text-xl text-gray-400 mb-8">
            Plataforma de comercio electrónico moderna con gestión de catálogo de productos, búsqueda avanzada, carrito de compras, pagos seguros, herramientas administrativas y un asistente virtual.
          </p>
        </div>

        <div class="mb-12 animate-fade-in" style="animation-delay: 0.1s">
          <div class="flex items-center justify-center h-96 overflow-hidden">
            <img 
              src="/images/ecommerce/ecommerce-main-page.JPG"
              alt="ecommerce-main-page"
              class="max-w-full h-full object-contain hover:scale-110 transition-transform duration-300 cursor-pointer"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-12">
          <div class="animate-fade-in" style="animation-delay: 0.2s">
                <div class="bg-gray-800/50 backdrop-blur-sm rounded-lg p-8 h-full flex items-center justify-center">
                <img
                    src="/images/ecommerce/ecommerce-main-page.JPG"
                    alt="ecommerce-main-page"
                />
                </div>
          </div>
          <div class="animate-fade-in" style="animation-delay: 0.3s">
            <div class="bg-gray-800/50 backdrop-blur-sm rounded-lg p-8 h-full">
              <h2 class="text-2xl font-bold mb-4">Descripción del Proyecto</h2>
              <p class="text-gray-300 leading-relaxed mb-4">
                Plataforma de comercio electrónico moderna que combina una experiencia de compra rápida y segura para los clientes con herramientas de gestión para administradores.
                Incluye catálogo de productos, búsqueda avanzada, carrito de compras, pagos en línea, asistente virtual y un panel administrativo para la gestión de inventario, productos, pedidos y clientes.
              </p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-1 gap-12 mb-12">
          <div class="animate-fade-in" style="animation-delay: 0.5s">
            <h2 class="text-2xl font-bold mb-8">Características</h2>
            
            <div class="mb-12">
              <h3 class="text-2xl font-bold mb-6">Módulo de ventas</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-4">
                {[
                  { title: "Catálogo de productos y búsqueda avanzada", icon: "/images/ecommerce/ecommerce-catalogo.JPG" },
                  { title: "Detalle de productos", icon: "/images/ecommerce/ecommerce-producto.JPG" },
                  { title: "Carro de compras", icon: "/images/ecommerce/ecommerce-carrito-compras.JPG" },
                  { title: "Pasarela de pago", icon: "/images/ecommerce/ecommerce-pasarela-pago.JPG" },
                  { title: "Chatbot de asistencia", icon: "/images/ecommerce/ecommerce-chatbot.JPG" }
                ].map((feature) => (
                  <div class="feature-card group">
                    <div class="feature-image">
                    {feature.icon.startsWith("/") ? (
                        <img
                        src={feature.icon}
                        alt={feature.title}
                        class="w-64 h-64 md:w-80 md:h-80 object-contain"
                        />
                    ) : (
                        <span class="text-5xl md:text-6xl">{feature.icon}</span>
                    )}
                    </div>
                    <div class="feature-content">
                      <p class="font-semibold text-center text-gray-100">{feature.title}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div>
              <h3 class="text-2xl font-bold mb-6">Módulo administrativo</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
                {[
                  { title: "Gestión de productos", icon: "🏷️" },
                  { title: "Gestión de inventario", icon: "📊" },
                  { title: "Gestión de pedidos", icon: "📦" },
                  { title: "Gestión de usuarios", icon: "👥" },
                  { title: "Reportes y estadísticas", icon: "📈" }
                ].map((feature) => (
                  <div class="feature-card group">
                    <div class="feature-image">
                      <span class="text-5xl">{feature.icon}</span>
                    </div>
                    <div class="feature-content">
                      <p class="font-semibold text-center text-gray-100">{feature.title}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-12">
          <div class="animate-fade-in" style="animation-delay: 0.4s">
            <h2 class="text-2xl font-bold mb-4">Tecnologías</h2>
            <div class="flex flex-wrap gap-3">
              {["TypeScript", "React" , "Node.js", "Express", "MongoDB"].map((tech) => (
                <span class="px-4 py-2 bg-blue/20 text-blue rounded-full">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>

        <div class="flex gap-4 animate-fade-in" style="animation-delay: 0.6s">
          <a 
            href="/" 
            class="px-6 py-3 bg-gray-800 text-white font-bold rounded-lg hover:bg-gray-700 transition-colors"
          >
            Volver al Portafolio
          </a>
        </div>
      </div>
    </main>
  </div>
</Layout>

<style>
  .animate-fade-in {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.6s ease-out forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .feature-card {
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.8) 0%, rgba(15, 23, 42, 0.8) 100%);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(71, 85, 105, 0.5);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    transition: all 0.3s ease;
    cursor: pointer;
    min-height: 180px;
  }

  .feature-card:hover {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.15) 0%, rgba(37, 99, 235, 0.1) 100%);
    border-color: rgba(59, 130, 246, 0.8);
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(59, 130, 246, 0.2);
  }

  .feature-image {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 1rem;
    transition: transform 0.3s ease;
  }

  .feature-card:hover .feature-image {
    transform: scale(1.1);
  }

  .feature-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .feature-content p {
    font-size: 0.95rem;
    line-height: 1.4;
  }
</style>
