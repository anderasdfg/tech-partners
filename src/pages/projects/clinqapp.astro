---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import { useTranslations } from '../../lib/i18n';
import { getLangFromUrl } from '../../lib/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title="ClinqApp - Tech Partners" lang={lang}>
  <Navigation />
  <div class="min-h-screen flex flex-col">

    <main class="flex-1 container mx-auto px-4 py-20">
      <div class="max-w-4xl mx-auto">
        <div class="mb-12 animate-fade-in">
          <img 
            src="/images/clinqapp_logo.png" 
            alt="ClinqApp Logo" 
            class="h-32 mb-4"
          />
          <p class="text-xl text-gray-400 mb-8">
            Plataforma para podólogos con gestión de citas, facturación y seguimiento de pacientes.
          </p>
        </div>

        <div class="mb-12 animate-fade-in" style="animation-delay: 0.1s">
          <div class="flex items-center justify-center h-96 overflow-hidden">
            <img 
              src="/images/clinqapp.png" 
              alt="ClinqApp" 
              class="max-w-full h-full object-contain hover:scale-110 transition-transform duration-300 cursor-pointer"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-12">
          <div class="animate-fade-in" style="animation-delay: 0.2s">
            <div class="bg-gray-800/50 backdrop-blur-sm rounded-lg p-8 h-full flex items-center justify-center">
              <video 
                controls 
                class="w-full rounded-lg"
              >
                <source src="/videos/clinqapp.mp4" type="video/mp4" />
                Tu navegador no soporta el elemento de video.
              </video>
            </div>
          </div>

          <div class="animate-fade-in" style="animation-delay: 0.3s">
            <div class="bg-gray-800/50 backdrop-blur-sm rounded-lg p-8 h-full">
              <h2 class="text-2xl font-bold mb-4">Descripción del Proyecto</h2>
              <p class="text-gray-300 leading-relaxed mb-4">
                ClinqApp es una solución integral diseñada específicamente para profesionales de la podología. 
                La plataforma simplifica la gestión diaria de la consulta, desde la programación de citas hasta 
                la facturación y el seguimiento del historial de pacientes.
              </p>
              <p class="text-gray-300 leading-relaxed">
                Con una interfaz intuitiva y herramientas potentes, ClinqApp permite a los podólogos enfocarse 
                en lo que realmente importa: brindar excelente atención a sus pacientes.
              </p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-12">
          <div class="animate-fade-in" style="animation-delay: 0.4s">
            <h2 class="text-2xl font-bold mb-4">Tecnologías</h2>
            <div class="flex flex-wrap gap-3">
              {["React", "TypeScript", "TailwindCSS", "Node.js", "PostgreSQL"].map((tech) => (
                <span class="px-4 py-2 bg-blue/20 text-blue rounded-full">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <div class="animate-fade-in" style="animation-delay: 0.5s">
            <h2 class="text-2xl font-bold mb-4">Características</h2>
            <ul class="space-y-2 text-gray-300">
              <li>✓ Gestión de citas y calendario</li>
              <li>✓ Facturación automática</li>
              <li>✓ Seguimiento de pacientes</li>
              <li>✓ Historial médico digital</li>
              <li>✓ Reportes y análisis</li>
            </ul>
          </div>
        </div>

        <div class="flex gap-4 animate-fade-in" style="animation-delay: 0.6s">
          <a 
            href="https://www.clinqapp.net" 
            target="_blank"
            class="px-6 py-3 bg-blue text-gray-900 font-bold rounded-lg hover:bg-green transition-colors"
          >
            Visitar Sitio
          </a>
          <a 
            href="/" 
            class="px-6 py-3 bg-gray-800 text-white font-bold rounded-lg hover:bg-gray-700 transition-colors"
          >
            Volver al Portafolio
          </a>
        </div>
      </div>
    </main>
  </div>
</Layout>

<style>
  .animate-fade-in {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.6s ease-out forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
