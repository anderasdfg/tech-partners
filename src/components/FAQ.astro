---
const faqs = [
  {
    question: 'What services do you offer?',
    answer: 'We offer web development, mobile app development, custom software solutions, and digital transformation services.',
  },
  {
    question: 'How long does a typical project take?',
    answer: 'Project timelines vary based on scope and complexity. We\'ll provide a detailed estimate after our initial consultation.',
  },
  {
    question: 'Do you offer maintenance and support?',
    answer: 'Yes, we provide ongoing maintenance and support services to ensure your solution remains up-to-date and secure.',
  },
];
---
<section id="faq" class="py-20 bg-white">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-gray-900 mb-4 animate-fade-up">
        Frequently Asked Questions
      </h2>
    </div>

    <div class="max-w-3xl mx-auto">
      {faqs.map((faq, index) => (
        <div class={`mb-4 animate-fade-up animate-delay-${(index + 1) * 200}`}>
          <button
            class="w-full text-left bg-gray-50 rounded-lg p-6 hover:bg-gray-100 transition-colors duration-200"
            aria-expanded="false"
            aria-controls={`faq-${index}`}
          >
            <div class="flex justify-between items-center">
              <h3 class="text-lg font-semibold text-gray-900">
                {faq.question}
              </h3>
              <svg
                class="w-6 h-6 text-gray-500 transform transition-transform duration-200"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </div>
          </button>
          <div
            id={`faq-${index}`}
            class="hidden overflow-hidden"
          >
            <div class="p-6 bg-white rounded-b-lg">
              <p class="text-gray-600">
                {faq.answer}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-up {
    animation: fade-up 0.8s ease-out forwards;
    opacity: 0;
  }

  .animate-delay-200 {
    animation-delay: 0.2s;
  }

  .animate-delay-400 {
    animation-delay: 0.4s;
  }

  .animate-delay-600 {
    animation-delay: 0.6s;
  }
</style>

<script>
  document.querySelectorAll('[aria-controls]').forEach((button) => {
    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') === 'true';
      const content = document.getElementById(button.getAttribute('aria-controls')!);
      const icon = button.querySelector('svg');

      button.setAttribute('aria-expanded', (!expanded).toString());
      content?.classList.toggle('hidden');
      icon?.classList.toggle('rotate-180');
    });
  });
</script> 